# This file contains local-development defaults only. Never reuse these
# credentials or enable the simulator in a live environment.
PAYMENTS_ENVIRONMENT=local

POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local-only
POSTGRES_PORT=5432

# Service-side URLs use the Compose network hostname. Percent-encode any
# reserved characters if you replace these local-only credentials.
PAYMENT_DATABASE_URL=postgres://payments:payments-local-only@postgres:5432/payments?sslmode=disable
GATEWAY_DATABASE_URL=postgres://payments:payments-local-only@postgres:5432/payments?sslmode=disable

PAYMENT_PORT=8080
ROUTER_PORT=8081
GATEWAY_PORT=8082
SIMULATOR_PORT=8083

# The simulator process hard-rejects non-local/test environments.
PROVIDER_ID=simulator_a
PROVIDER_WEBHOOK_SECRET=dev-webhook-secret
# Provider Gateway maps stable connection IDs to provider kinds. Router selects
# the two explicit account/region IDs. The legacy simulator_a ID is recovery-only
# and must remain configured until pre-migration operations and webhooks drain.
PROVIDER_CONNECTION_PROVIDERS=simulator_a=simulator_a,simulator_a_us_primary=simulator_a,simulator_a_eu_backup=simulator_a
PROVIDER_CONNECTION_REVISIONS=simulator_a=legacy_v1,simulator_a_us_primary=simulator_a_us_primary_v1,simulator_a_eu_backup=simulator_a_eu_backup_v1
PROVIDER_NAMESPACE_IDS=simulator_a=simulator_a,simulator_a_us_primary=simulator_a,simulator_a_eu_backup=simulator_a
PROVIDER_RECOVERY_ALIASES=simulator_a=simulator_a_us_primary
# Local Simulator revisions explicitly declare that their structured
# operation_not_found response is conclusive. Never infer this for a real PSP.
PROVIDER_CONCLUSIVE_ABSENCE=simulator_a=true,simulator_a_us_primary=true,simulator_a_eu_backup=true
# Provider reference/event collision domains are not webhook authentication
# domains. Only explicit recovery aliases may authenticate a target connection.
INTERNAL_SERVICE_TOKEN=local-internal-token
PAYMENT_API_KEYS=merchant_demo=local-api-key
# Payment compares its process clock with PostgreSQL before admitting a new
# funds path or recovery claim. Non-local environments must set this explicitly
# from their measured NTP/database latency budget.
PAYMENT_MAX_CLOCK_SKEW=500ms

# Explicit reader-first routing rollout: deploy and make the selected Router
# reader ready before enabling the matching Payment writer. The local stack uses
# v3; Payment's unset default remains v2 outside local/test. v1/v2 are operator
# choices, never error-driven fallbacks from v3.
PAYMENT_ROUTER_API_VERSION=v3
# The deterministic Risk fixture is local/test-only and is rejected at startup
# in every other environment. A real v3 deployment needs an authorized Risk
# source; unavailable never degrades into allow.
PAYMENT_RISK_MODE=local_fixture
# Empty values select only the documented, time-limited local demo fixtures.
# Every other merchant/environment needs explicit, fresh, versioned profiles.
PAYMENT_MERCHANT_PROFILES_JSON=
ROUTER_V2_CONFIG_JSON=
ROUTER_V3_CONFIG_JSON=
# Readiness is scoped to the API contract assigned to this Router deployment.
# Optional expired v1/v2 readers do not evict this local v3 instance.
ROUTER_REQUIRED_API_VERSION=v3
